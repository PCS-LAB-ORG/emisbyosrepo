# Cortex XDR API credentials for end-to-end testing
#
# Copy this file to .env and fill in your real values:
#   cp test_data/.env.example test_data/.env
#
# Where to find these values:
#   Cortex XDR → Settings → Configurations → API Keys
#   Create a Standard key with Vulnerability Management scope.
#
# .env is gitignored — your credentials will never be committed.

# Cortex API URL  (shown on the API Keys settings page)
# Example: api-abc123.xdr.us.paloaltonetworks.com
CORTEX_FQDN=

# Cortex API key  (shown once at creation — copy it immediately)
CORTEX_API_KEY=

# Cortex API key ID  (numeric ID shown next to the key)
CORTEX_AUTH_ID=
